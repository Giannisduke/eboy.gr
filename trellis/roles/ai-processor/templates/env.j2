# Ollama Configuration
OLLAMA_HOST={{ ai_processor.ollama_host | default('127.0.0.1') }}
OLLAMA_PORT={{ ai_processor.ollama_port | default(11434) }}
OLLAMA_MODEL={{ ai_processor.ai_model_greek | default('ilsp/llama-krikri-8b-instruct:latest') }}

# English mode configuration
AI_MODEL_EN={{ ai_processor.ai_model_english | default('llama3.1:8b') }}
TRANSLATION_MODEL={{ ai_processor.translation_model | default('ilsp/llama-krikri-8b-instruct:latest') }}

# File Paths
XML_INPUT_DIR={{ www_root }}/{{ wordpress_sites.keys() | first }}/shared/web/app/themes/simple-city/scripts/xml_files
XML_OUTPUT_DIR={{ www_root }}/{{ wordpress_sites.keys() | first }}/shared/web/app/themes/simple-city/scripts/xml_files/enhanced
IMAGE_OUTPUT_DIR={{ www_root }}/{{ wordpress_sites.keys() | first }}/shared/web/app/uploads/ai-processed-images
LOG_DIR={{ www_root }}/{{ wordpress_sites.keys() | first }}/shared/web/app/themes/simple-city/scripts/product-ai-processor/logs

# Processing Configuration
BATCH_SIZE={{ ai_processor.batch_size }}
MAX_CONCURRENT_IMAGES={{ ai_processor.max_concurrent_images }}
IMAGE_QUALITY={{ ai_processor.image_quality }}
IMAGE_MAX_WIDTH={{ ai_processor.image_max_width }}
IMAGE_MAX_HEIGHT={{ ai_processor.image_max_height }}

# WooCommerce Auto-Import
WOO_AUTO_IMPORT={{ ai_processor.woo_auto_import | lower }}
WOO_URL={{ ai_processor.woo_url }}
WOO_CONSUMER_KEY={{ ai_processor.woo_consumer_key }}
WOO_CONSUMER_SECRET={{ ai_processor.woo_consumer_secret }}

# Image Background Removal
REMOVE_BG={{ 'true' if ai_processor.remove_bg | default(true) else 'false' }}
BG_THRESHOLD={{ ai_processor.bg_threshold | default(230) }}
REMBG_HOST={{ ai_processor.rembg_host | default('') }}
REMBG_PORT={{ ai_processor.rembg_port | default(7000) }}
REMBG_MODEL={{ ai_processor.rembg_model | default('birefnet-general') }}

# Debug
DEBUG={{ 'true' if ai_processor.debug | default(false) else 'false' }}
